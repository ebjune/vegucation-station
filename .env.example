# VegucationStation Environment Configuration
# Copy this file to .env and fill in your values

# Claude API Key (required for AI features)
# Get your key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Email Service Configuration (optional)
# Supported services: sendgrid, smtp, none
EMAIL_SERVICE=none

# SendGrid Configuration (if EMAIL_SERVICE=sendgrid)
SENDGRID_API_KEY=your_sendgrid_api_key_here

# SMTP Configuration (if EMAIL_SERVICE=smtp)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
SMTP_FROM_EMAIL=recipes@vegucationstation.com
SMTP_FROM_NAME=VegucationStation

# Recipe thermal printing (Windows GDI printer, e.g. POS-80)
# Exact printer name from Windows Settings → Bluetooth & devices → Printers & scanners
RECIPE_PRINTER_NAME=POS-80
# Set to false to open the system print dialog (useful for debugging printer name)
RECIPE_PRINT_SILENT=true
# Virtual page height in mm — one tall "page" reduces mid-receipt cuts (try 2000–5000)
RECIPE_PRINT_PAGE_HEIGHT_MM=3000
# Optional: scale printed output, e.g. 0.9 for slightly smaller text
# RECIPE_PRINT_SCALE=0.92

# Development Settings
NODE_ENV=development
