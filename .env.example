# VegucationStation Environment Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# REQUIRED for AI content (fun facts, recipes, item descriptions)
# Get your key at: https://console.anthropic.com/
# Each kiosk needs this once — copy .env.example to .env and set this value.
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OPTIONAL — improves automatic image search when adding new items (Pexels API)
# Get a free key at: https://www.pexels.com/api/
# Without this key, the app falls back to Wikimedia Commons for image search.
PEXELS_API_KEY=your_pexels_api_key_here

# =============================================================================
# OPTIONAL — everything below can be left at defaults for a basic kiosk setup
# =============================================================================

# Email Service (optional — recipe email feature)
# Supported services: sendgrid, smtp, none
EMAIL_SERVICE=none

# SendGrid Configuration (if EMAIL_SERVICE=sendgrid)
SENDGRID_API_KEY=your_sendgrid_api_key_here

# SMTP Configuration (if EMAIL_SERVICE=smtp)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
SMTP_FROM_EMAIL=recipes@vegucationstation.com
SMTP_FROM_NAME=VegucationStation

# Recipe thermal printing (Windows GDI printer, e.g. POS-80)
# Exact printer name from Windows Settings → Bluetooth & devices → Printers & scanners
RECIPE_PRINTER_NAME=POS-80
# Set to false to open the system print dialog (useful for debugging printer name)
RECIPE_PRINT_SILENT=true
# Virtual page height in mm — one tall "page" reduces mid-receipt cuts (try 2000–5000)
RECIPE_PRINT_PAGE_HEIGHT_MM=3000
# Optional: scale printed output, e.g. 0.9 for slightly smaller text
# RECIPE_PRINT_SCALE=0.92

# Development Settings
NODE_ENV=development

# Kiosk display mode (development/testing only — production installs always use kiosk mode)
# Set to true to test fullscreen kiosk UI without the title bar while running pnpm dev
KIOSK_MODE=false

# Optional: override the portable data folder (defaults to <app>/data when writable)
# Required for installs under Program Files, e.g.:
# VEGUCATION_DATA_DIR=C:\VegucationStation\data

# =============================================================================
# INSTALLED APP NOTE
# =============================================================================
# When running the installed .exe, copy this file to .env and place it next to
# VegucationStation.exe (e.g. C:\Program Files\VegucationStation\.env) so the
# app can load your API keys and settings.
#
# Inventory and runtime images live in data/ next to the executable (or project
# root in development). Commit data/ to git to sync inventory to the kiosk.
